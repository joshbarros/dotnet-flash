# Compose publishes every port on 127.0.0.1 only: Postgres 5484 · Kafka 9134 · RabbitMQ 5714 (management 15714) · API 5224 · web 8104
# Copy to .env (git-ignored). Compose reads it automatically.
# Signing key for access tokens: at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_KEY=
# The administrator created on first start (only if no user has this email yet).
ADMIN_EMAIL=admin@flash.local
ADMIN_PASSWORD=
